// Linden Clinic — data model.
// Provider is SQLite for zero-config local dev. To deploy on Postgres,
// change `provider` to "postgresql" and set DATABASE_URL accordingly,
// then run `npm run db:push`. JSON payloads are stored as TEXT (String)
// so the schema is identical across SQLite and Postgres.
//
// Generic instrument engine (see docs/target-data-model.md): a questionnaire
// is data (Instrument + Scale rows), a filled-out questionnaire is a
// ResponseInstance, and its computed scores are ScaleScore rows.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Clinic staff: therapists, the clinic director, and administrators
/// (administration can assign patients but never sees clinical data).
model User {
  id           String    @id @default(cuid())
  name         String
  title        String
  role         String // "therapist" | "director" | "admin"
  email        String    @unique
  passwordHash String
  patients     Patient[] @relation("TherapistPatients")
  /// Sessions/occasions this staff member is recorded as having conducted —
  /// see ResponseInstance.conductedById. Distinct from TherapistPatients,
  /// which is the *current* patient assignment, not a per-occasion record.
  conducted    ResponseInstance[] @relation("ResponseConductedBy")
  sessionLogs  SessionLog[] @relation("SessionLogConductedBy")
  createdAt    DateTime  @default(now())
}

model Patient {
  id             String             @id @default(cuid())
  name           String
  email          String?            @unique // login + LimeSurvey invitations
  passwordHash   String? // set when the patient registered themselves (or was given credentials)
  color          String
  status         String // "assessment" | "interview" | "therapy" | "archived"
  disorderCategory String? // "anxiety" | "depression" | "eating_disorder" | "adhd" | "burnout" | "other" — set at diagnosis
  /// Research pseudonym following the legacy "A00120"-style convention
  /// (docs/outcome-prediction.md §4.4) — used in every export instead of names.
  code           String?            @unique
  /// ICD-10 code next to the coarse disorderCategory (§4.7) — categories filter,
  /// codes are what prediction papers stratify on.
  icdCode        String?
  /// Treatment episode boundaries (§4.2, the ML target labels): start is set
  /// when the diagnosis is recorded (status flips to "therapy"), end when the
  /// treatment is concluded. Distinct from archivedAt (a bookkeeping timestamp).
  treatmentStartAt DateTime?
  treatmentEndAt   DateTime?
  /// Coded termination reason — "completed" | "dropout" | "mutual" | "transfer"
  /// | "other". Dropout is *therapist judgment* (clinic decision, §6.2), coded
  /// by the concluding clinician. Replaces the old two-value archiveOutcome.
  terminationReason String?
  /// Coded intake predictors (§4.3, the classic ETR set): JSON
  /// CaseCharacteristics — problemDuration, priorPsychotherapy,
  /// psychotropicMedication, employment, treatmentExpectation. Coded fields
  /// only, never free text (see src/lib/types.ts).
  caseCharacteristics String          @default("{}")
  /// True for synthetic patients generated by src/lib/simulation/ — the
  /// stand-in reference sample. Excluded from research exports by default;
  /// removable via `npm run sim:purge` when real data accrues.
  simulated      Boolean            @default(false)
  /// Treatment conclusion ("archive"): set by the director or the assigned
  /// therapist when therapy ends. archivedBy mirrors diagnosisBy (staff
  /// display name); the treatment-end label lives in terminationReason.
  archivedAt     DateTime?
  archivedBy     String?
  therapistId    String?
  therapist      User?              @relation("TherapistPatients", fields: [therapistId], references: [id])
  demographics   String             @default("{}") // JSON object
  assessmentDate DateTime?
  diagnosisText  String?
  diagnosisDate  DateTime?
  diagnosisBy    String?
  responses      ResponseInstance[]
  invitations    QuestionnaireInvitation[]
  sessionLogs    SessionLog[]
  createdAt      DateTime           @default(now())
}

/// A therapy session that happened (or didn't) WITHOUT a questionnaire —
/// held-but-unmeasured sessions, cancellations and no-shows. Needed for true
/// dose–response and dropout-timing analyses (docs/outcome-prediction.md §4.5);
/// questionnaire-measured sessions live in ResponseInstance, and analyses join
/// both sources.
model SessionLog {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  occurredAt    DateTime
  type          String // "held" | "cancelled" | "no_show"
  conductedById String?
  conductedBy   User?    @relation("SessionLogConductedBy", fields: [conductedById], references: [id])
  note          String   @default("")
  createdAt     DateTime @default(now())

  @@index([patientId])
}

/// A questionnaire definition: items, scales, scoring, rater, cadence.
/// One row per instrument (and per rater variant), e.g. "bdi_fs", "sdq_parent_4_17".
/// definitionStatus mirrors itemSchemaStatus in docs/instrument-catalog.json:
/// only "complete" instruments can be rendered as forms and scored — "partial" /
/// "not_extracted" rows exist so the catalog is visible in the app, with the gap
/// surfaced instead of silently guessed at.
model Instrument {
  id                 String             @id // stable slug, e.g. "bdi_fs"
  name               String
  abbreviation       String
  population         String // "adult" | "adolescent_11_17" | "child_2_4" | ...
  raterRole          String // default rater: "self" | "parent" | "teacher" | "caregiver" | "clinician"
  instrumentType     String // "likert_battery" | "structured_interview"
  cadenceType        String // "every_session" | "wave" | "periodic" | "intake_once"
  cadenceConfig      String             @default("{}") // JSON, e.g. {"waves":["pre","zm","post","postF"]}
  definitionStatus   String             @default("complete") // "complete" | "partial" | "not_extracted"
  itemSchema         String             @default("[]") // JSON: ItemDef[] (see src/lib/instruments/types.ts)
  sourceNotes        String             @default("")
  limesurveySurveyId String? // LimeSurvey survey id for this instrument, once linked
  limesurveyMapping  String             @default("{}") // JSON { lsQuestionCode: itemId } when LS codes differ from item ids
  scales             Scale[]
  responses          ResponseInstance[]
  invitations        QuestionnaireInvitation[]
  createdAt          DateTime           @default(now())
}

/// One computed sub-score for an instrument (e.g. BDI_FS_total, or PSTB's
/// Therapiebeziehung). formula is interpreted by the scoring engine, not by Prisma.
model Scale {
  id           String       @id @default(cuid())
  instrumentId String
  instrument   Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  key          String // "BDI_FS_total"
  label        String
  formula      String // JSON FormulaDef: { type: "sum"|"mean"|"prorated_sum"|"custom", items, missingTolerance?, expression? }
  normBands    String? // JSON: [{ min, max, label }] — reference bands on charts
  range        String? // JSON: { min, max } — theoretical score range (chart y-axis)
  meta         String  @default("{}") // JSON: { higherIsBetter?, alert?: {gte,message}, rci?: {reliability,sd,note} }
  sortOrder    Int          @default(0) // evaluation + display order (later scales may reference earlier keys)
  scores       ScaleScore[]

  @@unique([instrumentId, key])
}

/// One filled-out questionnaire: a patient, an instrument, an occasion, a rater.
model ResponseInstance {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  instrumentId   String
  instrument     Instrument   @relation(fields: [instrumentId], references: [id])
  respondentRole String // "self" | "mother" | "father" | "parent" | "teacher" | ...
  sessionNumber  Int? // set when instrument.cadenceType == "every_session" (0 = baseline)
  wave           String? // "pre" | "zm" | "post" | "postF", when cadenceType == "wave"
  /// Staff member who conducted/recorded this occasion — the digital equivalent
  /// of the legacy PSTB Hilfsskript's per-session "Therapeut" column. Nullable:
  /// not every response has a clinician present (e.g. a wave-based self-report
  /// questionnaire filled in remotely). Best-effort defaulted to the patient's
  /// current therapistId at submission time when not explicitly set — see
  /// src/app/api/patients/[id]/responses/route.ts.
  conductedById  String?
  conductedBy    User?        @relation("ResponseConductedBy", fields: [conductedById], references: [id])
  occurredAt     DateTime
  rawAnswers     String // JSON: { itemId: value }
  status         String       @default("complete") // "complete" | "partial"
  source         String       @default("in_app") // "in_app" | "limesurvey" | "csv_import" | "manual_entry" | "seed"
  note           String       @default("") // free-text note from the respondent (check-in comment)
  meta           String       @default("{}") // JSON extras (e.g. DIPS: lang, fhir payload, relay status)
  scaleScores    ScaleScore[]
  createdAt      DateTime     @default(now())

  @@index([patientId, instrumentId])
}

/// Denormalized computed score per (response, scale) — what trajectory charts and
/// tables query directly, so they never re-run the formula.
model ScaleScore {
  id                 String           @id @default(cuid())
  responseInstanceId String
  responseInstance   ResponseInstance @relation(fields: [responseInstanceId], references: [id], onDelete: Cascade)
  scaleId            String
  scale              Scale            @relation(fields: [scaleId], references: [id])
  value              Float

  @@unique([responseInstanceId, scaleId])
}

/// A tracked "please fill this out" link sent (or to be sent) to a respondent via
/// LimeSurvey. See docs/limesurvey-integration.md.
model QuestionnaireInvitation {
  id             String     @id @default(cuid())
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  instrumentId   String
  instrument     Instrument @relation(fields: [instrumentId], references: [id])
  respondentRole String     @default("self")
  email          String
  surveyId       String? // LimeSurvey survey id used
  token          String? // LimeSurvey participant token
  tokenId        String? // LimeSurvey participant tid (needed for invite/remind calls)
  url            String? // direct tokenised survey URL
  status         String     @default("created") // "created" | "invited" | "reminded" | "completed" | "error"
  context        String     @default("{}") // JSON { wave?, sessionNumber? } applied when the response is imported
  sentAt         DateTime?
  remindedAt     DateTime?
  completedAt    DateTime?
  responseId     String? // ResponseInstance id once imported
  lastError      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}
