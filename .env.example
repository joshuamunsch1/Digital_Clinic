# --- Database ---
# SQLite (default, zero-config for local dev):
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma datasource provider to "postgresql" and use e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/linden?schema=public"

# --- FHIR relay (optional) ---
# If set, each completed QuestionnaireResponse is forwarded (POST) to this external FHIR server
# in addition to being stored locally. Leave blank to store locally only.
FHIR_RELAY_URL=""

# --- Mock auth ---
# Secret used to sign the (mock) session cookie. Replace with a real value in any deployment.
SESSION_SECRET="dev-only-change-me"

# --- LimeSurvey integration (optional) ---
# When set, therapists can send questionnaire invitations/reminders through
# LimeSurvey and pull completed responses back automatically (RemoteControl 2
# API must be enabled in LimeSurvey: Global settings -> Interfaces -> JSON-RPC).
# Leave blank to use manual CSV import instead. See docs/limesurvey-integration.md.
LIMESURVEY_URL=""
LIMESURVEY_USERNAME=""
LIMESURVEY_PASSWORD=""

# --- Patient documents (optional) ---
# Where uploaded timeline documents (consent forms, reports, ...) are stored on
# disk. Defaults to ./documents next to the app. The demo seed wipes and
# re-populates this directory.
DOCUMENTS_DIR=""

# --- Network restriction (optional) ---
# Staff (therapist/director/admin) may only access clinic data from these
# IPv4 networks (comma-separated CIDRs). Patients can register, log in and
# submit their own questionnaires from anywhere. Leave blank to disable
# (dev default). PLACEHOLDER: replace with the university network ranges,
# e.g. ALLOWED_NETWORK_CIDRS="130.92.0.0/16,10.0.0.0/8"
ALLOWED_NETWORK_CIDRS=""
